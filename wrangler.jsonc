// Cloudflare Workers static assets: serves the Vite build as a single-page app.
// Build: npm run build-only · Production deploy: npx wrangler deploy · PR branches: npx wrangler preview
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sports-edgebook",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Required by `wrangler preview` (Cloudflare Previews, used for non-production branches). Empty is valid.
  "previews": {},
}
